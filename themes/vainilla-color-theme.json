    "editorOverviewRuler.addedForeground": "#26734F",
    "editorOverviewRuler.modifiedForeground": "#A34C12",
    "editorOverviewRuler.deletedForeground": "#B23A55",
    "editorOverviewRuler.errorForeground": "#B23A55",
    "editorOverviewRuler.warningForeground": "#7C5E0C",

    "diffEditor.insertedLineBackground": "#D8F0E2",
    "diffEditor.insertedTextBackground": "#A9DFC277",
    "diffEditor.removedLineBackground": "#F7DCE1",
    "diffEditor.removedTextBackground": "#EBA9B677",
    "diffEditorGutter.insertedLineBackground": "#C4E7D3",
    "diffEditorGutter.removedLineBackground": "#F0C7CF",
    "diffEditor.diagonalFill": "#CFC5A0",

    "editorWidget.background": "#E4DBB8",
    "editorWidget.border": "#CFC5A0",
    "editorSuggestWidget.background": "#E4DBB8",
    "editorSuggestWidget.border": "#CFC5A0",
    "editorSuggestWidget.foreground": "#654027",
    "editorSuggestWidget.selectedBackground": "#E6DCF2",
    "editorSuggestWidget.highlightForeground": "#7D4FAA",
    "editorHoverWidget.background": "#E4DBB8",
    "editorHoverWidget.border": "#CFC5A0",
    "peekView.border": "#7D4FAA",
    "peekViewEditor.background": "#F0E1A9",
    "peekViewResult.background": "#E4DBB8",
    "peekViewTitle.background": "#DFD5B1",

    "scrollbarSlider.background": "#C5BB9666",
    "scrollbarSlider.hoverBackground": "#C5BB9699",
