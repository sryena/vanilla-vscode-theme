    "diffEditor.insertedTextBackground": "#A9DFC277",
    "diffEditor.removedLineBackground": "#F7DCE1",
    "diffEditor.removedTextBackground": "#EBA9B677",
    "diffEditorGutter.insertedLineBackground": "#C4E7D3",
    "diffEditorGutter.removedLineBackground": "#F0C7CF",
    "diffEditor.diagonalFill": "#D6CEB8",

    "editorWidget.background": "#EAE4D3",
    "editorWidget.border": "#D6CEB8",
    "editorSuggestWidget.background": "#EAE4D3",
    "editorSuggestWidget.border": "#D6CEB8",
    "editorSuggestWidget.foreground": "#4A3F35",
    "editorSuggestWidget.selectedBackground": "#E6DCF2",
    "editorSuggestWidget.highlightForeground": "#8456B0",
    "editorHoverWidget.background": "#EAE4D3",
    "editorHoverWidget.border": "#D6CEB8",
