    "panel.background": "#F9E9AF",
    "panel.border": "#CFC5A0",
    "panelTitle.activeBorder": "#7D4FAA",
    "panelTitle.activeForeground": "#654027",
    "panelTitle.inactiveForeground": "#7F6A4A",

    "terminal.background": "#F9E9AF",
    "terminal.foreground": "#654027",
    "terminalCursor.foreground": "#B23A55",
    "terminal.selectionBackground": "#E6DCF2",
    "terminal.ansiBlack": "#654027",
    "terminal.ansiRed": "#B23A55",
    "terminal.ansiGreen": "#26734F",
    "terminal.ansiYellow": "#7C5E0C",
    "terminal.ansiBlue": "#286A96",
    "terminal.ansiMagenta": "#7D4FAA",
    "terminal.ansiCyan": "#227A80",
    "terminal.ansiWhite": "#837954",
    "terminal.ansiBrightBlack": "#857455",
    "terminal.ansiBrightRed": "#C24E69",
    "terminal.ansiBrightGreen": "#348C68",
    "terminal.ansiBrightYellow": "#A34C12",
    "terminal.ansiBrightBlue": "#3A80AE",
    "terminal.ansiBrightMagenta": "#A3427B",
    "terminal.ansiBrightCyan": "#2E8C93",
    "terminal.ansiBrightWhite": "#9F9260",

    "statusBar.background": "#D9D0AA",
    "statusBar.foreground": "#654027",
    "statusBar.border": "#CFC5A0",
    "statusBar.noFolderBackground": "#E6DCF2",
    "statusBar.debuggingBackground": "#F7CFA4",
    "statusBar.debuggingForeground": "#654027",
    "statusBarItem.hoverBackground": "#D4CAA3",
    "statusBarItem.remoteBackground": "#7D4FAA",
    "statusBarItem.remoteForeground": "#F9E9AF",
    "statusBarItem.errorBackground": "#B23A55",
    "statusBarItem.errorForeground": "#F9E9AF",

    "button.background": "#7D4FAA",
    "button.foreground": "#F9E9AF",
    "button.hoverBackground": "#663F8F",
    "button.secondaryBackground": "#D9D0AA",
    "button.secondaryForeground": "#654027",
    "button.secondaryHoverBackground": "#D4CAA3",
    "badge.background": "#7D4FAA",
    "badge.foreground": "#F9E9AF",
    "progressBar.background": "#7D4FAA",

    "input.background": "#F9E9AF",
    "input.foreground": "#654027",
    "input.border": "#CFC5A0",
    "input.placeholderForeground": "#938962",
    "inputOption.activeBorder": "#7D4FAA",
    "inputOption.activeBackground": "#E6DCF2",
    "inputValidation.errorBackground": "#F7DCE1",
    "inputValidation.errorBorder": "#B23A55",
    "inputValidation.warningBackground": "#F3E6C2",
    "inputValidation.warningBorder": "#7C5E0C",
    "inputValidation.infoBackground": "#DCE9F3",
    "inputValidation.infoBorder": "#286A96",
    "dropdown.background": "#F9E9AF",
    "dropdown.border": "#CFC5A0",
    "dropdown.foreground": "#654027",
    "checkbox.background": "#F9E9AF",
    "checkbox.border": "#C5BB96",

    "quickInput.background": "#E4DBB8",
    "quickInput.foreground": "#654027",
    "quickInputList.focusBackground": "#E6DCF2",
    "quickInputList.focusForeground": "#654027",
    "pickerGroup.foreground": "#7D4FAA",
    "pickerGroup.border": "#CFC5A0",
    "keybindingLabel.background": "#DFD5B1",
    "keybindingLabel.foreground": "#654027",
    "keybindingLabel.border": "#CFC5A0",
    "keybindingLabel.bottomBorder": "#C5BB96",

    "menu.background": "#E4DBB8",
    "menu.foreground": "#654027",
    "menu.selectionBackground": "#E6DCF2",
    "menu.selectionForeground": "#654027",
    "menu.separatorBackground": "#CFC5A0",
    "menu.border": "#CFC5A0",
    "menubar.selectionBackground": "#D4CAA3",

    "notifications.background": "#E4DBB8",
    "notifications.foreground": "#654027",
    "notifications.border": "#CFC5A0",
    "notificationCenterHeader.background": "#DFD5B1",
    "notificationsErrorIcon.foreground": "#B23A55",
    "notificationsWarningIcon.foreground": "#7C5E0C",
    "notificationsInfoIcon.foreground": "#286A96",

    "settings.headerForeground": "#654027",
    "settings.modifiedItemIndicator": "#A34C12",
    "welcomePage.tileBackground": "#E4DBB8",
    "walkThrough.embeddedEditorBackground": "#F0E1A9",

    "charts.red": "#B23A55",
    "charts.green": "#26734F",
    "charts.yellow": "#7C5E0C",
    "charts.orange": "#A34C12",
    "charts.blue": "#286A96",
    "charts.purple": "#7D4FAA",
    "charts.foreground": "#654027",
    "charts.lines": "#C5BB96"
  },
  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#857455", "fontStyle": "italic" }
    },
    {
      "name": "Palabras clave",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.other.important.css"],
      "settings": { "foreground": "#7D4FAA" }
    },
    {
      "name": "Operadores",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#7F6A4A" }
    },
    {
      "name": "Operadores con palabra (and, or, not, in)",
      "scope": ["keyword.operator.logical.python", "keyword.operator.word"],
      "settings": { "foreground": "#7D4FAA" }
    },
    {
      "name": "Textos entre comillas",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#26734F" }
    },
    {
      "name": "Caracteres de escape y marcadores de formato",
      "scope": ["constant.character.escape", "constant.character.format.placeholder", "meta.format.percent", "constant.other.placeholder"],
      "settings": { "foreground": "#A34C12" }
    },
    {
      "name": "Funciones",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": { "foreground": "#286A96" }
    },
    {
      "name": "Números y constantes",
      "scope": ["constant.numeric", "constant.language", "support.constant", "constant.other", "keyword.other.unit"],
      "settings": { "foreground": "#A34C12" }
    },
    {
      "name": "Clases y tipos",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "storage.type.class.python"],
      "settings": { "foreground": "#A3427B" }
    },
    {
      "name": "Decoradores",
      "scope": ["entity.name.function.decorator", "meta.function.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#A3427B", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#654027" }
    },
    {
      "name": "Parámetros",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#654027", "fontStyle": "italic" }
    },
    {
      "name": "self, this, cls",
      "scope": ["variable.language", "variable.parameter.function.language.special"],
      "settings": { "foreground": "#7D4FAA", "fontStyle": "italic" }
    },
    {
      "name": "Etiquetas HTML",
      "scope": ["entity.name.tag", "meta.tag.sgml.doctype", "entity.name.tag.css"],
      "settings": { "foreground": "#B23A55" }
    },
    {
      "name": "Signos < > / de las etiquetas",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#837954" }
    },
    {
      "name": "Atributos HTML",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#7C5E0C" }
    },
    {
      "name": "Entidades HTML (&amp; &lt;)",
      "scope": ["constant.character.entity", "punctuation.definition.entity"],
      "settings": { "foreground": "#A34C12" }
    },
    {
      "name": "CSS: selectores de clase",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.class"],
      "settings": { "foreground": "#7C5E0C" }
    },
    {
      "name": "CSS: selectores de id",
      "scope": ["entity.other.attribute-name.id.css", "entity.other.attribute-name.id"],
      "settings": { "foreground": "#A3427B" }
    },
    {
      "name": "CSS: pseudoclases (:hover)",
      "scope": ["entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
      "settings": { "foreground": "#7D4FAA" }
    },
    {
      "name": "CSS: propiedades",
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "#286A96" }
    },
    {
      "name": "CSS: valores con nombre (red, center)",
      "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color"],
      "settings": { "foreground": "#A34C12" }
    },
    {
      "name": "Markdown: títulos",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#B23A55", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: negrita",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown: cursiva",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown: código",
      "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown punctuation.definition"],
      "settings": { "foreground": "#26734F" }
    },
    {
      "name": "Markdown: enlaces",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#286A96" }
    },
    {
      "name": "Markdown: citas y listas",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#7D4FAA" }
    },
    {
      "name": "Diff: añadido",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#26734F" }
    },
    {
      "name": "Diff: borrado",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#B23A55" }
    },
    {
      "name": "Diff: cambiado",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#A34C12" }
    },
    {
      "name": "YAML y JSON: claves",
      "scope": ["entity.name.tag.yaml", "support.type.property-name.json"],
      "settings": { "foreground": "#286A96" }
    },
    {
      "name": "Código no válido",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#B23A55", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "function": "#286A96",
    "method": "#286A96",
    "class": "#A3427B",
    "type": "#A3427B",
    "enumMember": "#A34C12",
    "parameter": { "foreground": "#654027", "italic": true },
    "variable.readonly": "#A34C12",
    "selfParameter": { "foreground": "#7D4FAA", "italic": true },
    "decorator": { "foreground": "#A3427B", "italic": true },
    "module": "#654027"
  }
}
