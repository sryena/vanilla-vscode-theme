    "panelTitle.activeForeground": "#4A3F35",
    "panelTitle.inactiveForeground": "#7A6E5E",

    "terminal.background": "#FAF3E0",
    "terminal.foreground": "#4A3F35",
    "terminalCursor.foreground": "#B23A55",
    "terminal.selectionBackground": "#E6DCF2",
    "terminal.ansiBlack": "#4A3F35",
    "terminal.ansiRed": "#B23A55",
    "terminal.ansiGreen": "#2A7A59",
    "terminal.ansiYellow": "#84650F",
    "terminal.ansiBlue": "#2A6F9C",
    "terminal.ansiMagenta": "#8456B0",
    "terminal.ansiCyan": "#227A80",
    "terminal.ansiWhite": "#9A8F7C",
    "terminal.ansiBrightBlack": "#887D6B",
    "terminal.ansiBrightRed": "#C24E69",
    "terminal.ansiBrightGreen": "#348C68",
    "terminal.ansiBrightYellow": "#A8562A",
    "terminal.ansiBrightBlue": "#3A80AE",
    "terminal.ansiBrightMagenta": "#A8457F",
    "terminal.ansiBrightCyan": "#2E8C93",
    "terminal.ansiBrightWhite": "#B5AA95",

    "statusBar.background": "#DDD6C3",
    "statusBar.foreground": "#4A3F35",
    "statusBar.border": "#D6CEB8",
    "statusBar.noFolderBackground": "#E6DCF2",
    "statusBar.debuggingBackground": "#F6DCC6",
    "statusBar.debuggingForeground": "#4A3F35",
    "statusBarItem.hoverBackground": "#D0C8B3",
    "statusBarItem.remoteBackground": "#8456B0",
    "statusBarItem.remoteForeground": "#FAF3E0",
    "statusBarItem.errorBackground": "#B23A55",
    "statusBarItem.errorForeground": "#FAF3E0",

    "button.background": "#8456B0",
    "button.foreground": "#FAF3E0",
    "button.hoverBackground": "#6F4699",
    "button.secondaryBackground": "#DDD6C3",
    "button.secondaryForeground": "#4A3F35",
    "button.secondaryHoverBackground": "#D0C8B3",
    "badge.background": "#8456B0",
    "badge.foreground": "#FAF3E0",
    "progressBar.background": "#8456B0",

    "input.background": "#FAF3E0",
    "input.foreground": "#4A3F35",
    "input.border": "#D6CEB8",
    "input.placeholderForeground": "#A39883",
    "inputOption.activeBorder": "#8456B0",
    "inputOption.activeBackground": "#E6DCF2",
    "inputValidation.errorBackground": "#F7DCE1",
    "inputValidation.errorBorder": "#B23A55",
    "inputValidation.warningBackground": "#F3E6C2",
    "inputValidation.warningBorder": "#84650F",
    "inputValidation.infoBackground": "#DCE9F3",
    "inputValidation.infoBorder": "#2A6F9C",
    "dropdown.background": "#FAF3E0",
    "dropdown.border": "#D6CEB8",
    "dropdown.foreground": "#4A3F35",
    "checkbox.background": "#FAF3E0",
    "checkbox.border": "#C9BFA8",

    "quickInput.background": "#EAE4D3",
    "quickInput.foreground": "#4A3F35",
    "quickInputList.focusBackground": "#E6DCF2",
    "quickInputList.focusForeground": "#4A3F35",
    "pickerGroup.foreground": "#8456B0",
    "pickerGroup.border": "#D6CEB8",
    "keybindingLabel.background": "#E3DCC9",
    "keybindingLabel.foreground": "#4A3F35",
    "keybindingLabel.border": "#D6CEB8",
    "keybindingLabel.bottomBorder": "#C9BFA8",

    "menu.background": "#EAE4D3",
    "menu.foreground": "#4A3F35",
    "menu.selectionBackground": "#E6DCF2",
    "menu.selectionForeground": "#4A3F35",
    "menu.separatorBackground": "#D6CEB8",
    "menu.border": "#D6CEB8",
    "menubar.selectionBackground": "#D0C8B3",

    "notifications.background": "#EAE4D3",
    "notifications.foreground": "#4A3F35",
    "notifications.border": "#D6CEB8",
    "notificationCenterHeader.background": "#E3DCC9",
    "notificationsErrorIcon.foreground": "#B23A55",
    "notificationsWarningIcon.foreground": "#84650F",
    "notificationsInfoIcon.foreground": "#2A6F9C",

    "settings.headerForeground": "#4A3F35",
    "settings.modifiedItemIndicator": "#A8562A",
    "welcomePage.tileBackground": "#EAE4D3",
    "walkThrough.embeddedEditorBackground": "#F3EBD3",

    "charts.red": "#B23A55",
    "charts.green": "#2A7A59",
    "charts.yellow": "#84650F",
    "charts.orange": "#A8562A",
    "charts.blue": "#2A6F9C",
    "charts.purple": "#8456B0",
    "charts.foreground": "#4A3F35",
    "charts.lines": "#C9BFA8"
  },
  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#887D6B", "fontStyle": "italic" }
    },
    {
      "name": "Palabras clave",
      "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier", "keyword.other.important.css"],
      "settings": { "foreground": "#8456B0" }
    },
    {
      "name": "Operadores",
      "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#7A6E5E" }
    },
    {
      "name": "Operadores con palabra (and, or, not, in)",
      "scope": ["keyword.operator.logical.python", "keyword.operator.word"],
      "settings": { "foreground": "#8456B0" }
    },
    {
      "name": "Textos entre comillas",
      "scope": ["string", "string.quoted", "punctuation.definition.string"],
      "settings": { "foreground": "#2A7A59" }
    },
    {
      "name": "Caracteres de escape y marcadores de formato",
      "scope": ["constant.character.escape", "constant.character.format.placeholder", "meta.format.percent", "constant.other.placeholder"],
      "settings": { "foreground": "#A8562A" }
    },
    {
      "name": "Funciones",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"],
      "settings": { "foreground": "#2A6F9C" }
    },
    {
      "name": "Números y constantes",
      "scope": ["constant.numeric", "constant.language", "support.constant", "constant.other", "keyword.other.unit"],
      "settings": { "foreground": "#A8562A" }
    },
    {
      "name": "Clases y tipos",
      "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type", "entity.other.inherited-class", "storage.type.class.python"],
      "settings": { "foreground": "#A8457F" }
    },
    {
      "name": "Decoradores",
      "scope": ["entity.name.function.decorator", "meta.function.decorator", "punctuation.definition.decorator"],
      "settings": { "foreground": "#A8457F", "fontStyle": "italic" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#4A3F35" }
    },
    {
      "name": "Parámetros",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#4A3F35", "fontStyle": "italic" }
    },
    {
      "name": "self, this, cls",
      "scope": ["variable.language", "variable.parameter.function.language.special"],
      "settings": { "foreground": "#8456B0", "fontStyle": "italic" }
    },
    {
      "name": "Etiquetas HTML",
      "scope": ["entity.name.tag", "meta.tag.sgml.doctype", "entity.name.tag.css"],
      "settings": { "foreground": "#B23A55" }
    },
    {
      "name": "Signos < > / de las etiquetas",
      "scope": ["punctuation.definition.tag"],
      "settings": { "foreground": "#9A8F7C" }
    },
    {
      "name": "Atributos HTML",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#84650F" }
    },
    {
      "name": "Entidades HTML (&amp; &lt;)",
      "scope": ["constant.character.entity", "punctuation.definition.entity"],
      "settings": { "foreground": "#A8562A" }
    },
    {
      "name": "CSS: selectores de clase",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.class"],
      "settings": { "foreground": "#84650F" }
    },
    {
      "name": "CSS: selectores de id",
      "scope": ["entity.other.attribute-name.id.css", "entity.other.attribute-name.id"],
      "settings": { "foreground": "#A8457F" }
    },
    {
      "name": "CSS: pseudoclases (:hover)",
      "scope": ["entity.other.attribute-name.pseudo-class", "entity.other.attribute-name.pseudo-element"],
      "settings": { "foreground": "#8456B0" }
    },
    {
      "name": "CSS: propiedades",
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": { "foreground": "#2A6F9C" }
    },
    {
      "name": "CSS: valores con nombre (red, center)",
      "scope": ["support.constant.property-value", "support.constant.color", "constant.other.color"],
      "settings": { "foreground": "#A8562A" }
    },
    {
      "name": "Markdown: títulos",
      "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#B23A55", "fontStyle": "bold" }
    },
    {
      "name": "Markdown: negrita",
      "scope": ["markup.bold"],
      "settings": { "fontStyle": "bold" }
    },
    {
      "name": "Markdown: cursiva",
      "scope": ["markup.italic"],
      "settings": { "fontStyle": "italic" }
    },
    {
      "name": "Markdown: código",
      "scope": ["markup.inline.raw", "markup.fenced_code.block.markdown punctuation.definition"],
      "settings": { "foreground": "#2A7A59" }
    },
    {
      "name": "Markdown: enlaces",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#2A6F9C" }
    },
    {
      "name": "Markdown: citas y listas",
      "scope": ["markup.quote", "punctuation.definition.list.begin.markdown"],
      "settings": { "foreground": "#8456B0" }
    },
    {
      "name": "Diff: añadido",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#2A7A59" }
    },
    {
      "name": "Diff: borrado",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#B23A55" }
    },
    {
      "name": "Diff: cambiado",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#A8562A" }
    },
    {
      "name": "YAML y JSON: claves",
      "scope": ["entity.name.tag.yaml", "support.type.property-name.json"],
      "settings": { "foreground": "#2A6F9C" }
    },
    {
      "name": "Código no válido",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#B23A55", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "function": "#2A6F9C",
    "method": "#2A6F9C",
    "class": "#A8457F",
    "type": "#A8457F",
    "enumMember": "#A8562A",
    "parameter": { "foreground": "#4A3F35", "italic": true },
    "variable.readonly": "#A8562A",
    "selfParameter": { "foreground": "#8456B0", "italic": true },
    "decorator": { "foreground": "#A8457F", "italic": true },
    "module": "#4A3F35"
  }
}
